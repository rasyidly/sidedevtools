{
	"manifest_version": 3,
	"name": "SideDevTools - Privacy-First Developer Companion",
	"version": "1.3.0",
	"description": "Offline, privacy-first dev sidebar: color toolkit, TOTP 2FA, QR & barcode reader, AI BG remover, AnyDoc, regex, form filler & vault.",
	"author": "rasyidly <rasyid@sekeco.id>",
	"homepage_url": "https://github.com/rasyidly/sidedevtools",
	"permissions": [
		"sidePanel",
		"storage",
		"tabs",
		"activeTab",
		"scripting",
		"clipboardRead",
		"clipboardWrite"
	],
	"host_permissions": ["<all_urls>"],
	"content_security_policy": {
		"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https://staticimgly.com https://unpkg.com blob: data:; object-src 'self'"
	},
	"web_accessible_resources": [
		{
			"resources": ["onnxruntime-web/*", "anydoc/*", "assets/*"],
			"matches": ["<all_urls>"]
		}
	],
	"action": {
		"default_title": "Open DevTools Sidebar",
		"default_icon": {
			"16": "icons/favicon-16x16.png",
			"32": "icons/favicon-32x32.png",
			"192": "icons/android-chrome-192x192.png"
		}
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"side_panel": {
		"default_path": "sidepanel.html"
	},
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Ctrl+Shift+S",
				"mac": "Command+Shift+S"
			},
			"description": "Toggle DevTools Sidebar"
		}
	},
	"icons": {
		"16": "icons/favicon-16x16.png",
		"32": "icons/favicon-32x32.png",
		"192": "icons/android-chrome-192x192.png"
	}
}
